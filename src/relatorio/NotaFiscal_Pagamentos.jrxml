	<queryString>
		<![CDATA[SELECT transportadora.pagamento.`valorTotal`,
	transportadora.pagamento.`dataPagamento`,
	transportadora.funcionario.nome,
	transportadora.funcionario.nivel
FROM transportadora.pagamento
	INNER JOIN transportadora.funcionario ON 
	 transportadora.pagamento.`idFuncionario` = transportadora.funcionario.`idFuncionario`]]>
	</queryString>
