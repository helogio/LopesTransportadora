	<queryString>
		<![CDATA[SELECT transportadora.transporte.`dataCarregou`,
	transportadora.transporte.`dataDescarregou`,
	transportadora.transporte.qtde,
	transportadora.transporte.`valorFrete`,
	transportadora.carga.origem,
	transportadora.carga.destino,
	transportadora.colaborador.nome
FROM transportadora.transporte
	INNER JOIN transportadora.carga ON 
	 transportadora.transporte.`idCarga` = transportadora.carga.`idCarga` 
	INNER JOIN transportadora.colaborador ON 
	 transportadora.transporte.`idColaborador` = transportadora.colaborador.`idColaborador`]]>
	</queryString>
