	<queryString>
		<![CDATA[SELECT transportadora.produto.tipo,
	transportadora.cliente.nome,
	transportadora.carga.origem,
	transportadora.carga.destino,
	transportadora.carga.`qtdeTotal`,
	transportadora.carga.`valorCarga`
FROM transportadora.carga
	INNER JOIN transportadora.produto ON 
	 transportadora.carga.`idProduto` = transportadora.produto.`idProduto` 
	INNER JOIN transportadora.cliente ON 
	 transportadora.carga.`idCliente` = transportadora.cliente.`idCliente`]]>
	</queryString>
