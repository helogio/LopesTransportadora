	<queryString>
		<![CDATA[SELECT transportadora.transporte.`dataCarregou`,
	transportadora.transporte.`dataDescarregou`,
	transportadora.transporte.qtde,
	transportadora.transporte.`valorFrete`,
	transportadora.pagamentotransporte.`valorParcela`,
	transportadora.pagamentotransporte.`dataPagamento`
FROM transportadora.pagamentotransporte
	INNER JOIN transportadora.transporte ON 
	 transportadora.pagamentotransporte.`idTransporte` = transportadora.transporte.`idTransporte`]]>
	</queryString>
